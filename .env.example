# Vorlage für die lokale Konfiguration.
# Kopieren nach `.env` und mit echten Werten füllen. `.env` ist gitignored.

# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# API-Key der GCS AcademicCloud (OpenAI-kompatible Chat-API).
# Sobald dieser Key gesetzt ist, aktiviert CodeMentor den Live-LLM-Modus und
# die API-Embeddings für RAG automatisch.
API_KEY=

# GitHub Personal Access Token mit `repo`-Scope.
# Wird für Pull-Request-Daten, Review-Kommentare und den Download der
# GitHub-Actions-Artefakte benötigt.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Optional — alle Werte haben sinnvolle Defaults (siehe src/codementor/config.py)
# ---------------------------------------------------------------------------

# LLM
# CODEMENTOR_LLM_MODEL=devstral-2-123b-instruct-2512
# CODEMENTOR_LLM_TEMPERATURE=0.2
# CODEMENTOR_LLM_BASE_URL=https://chat-ai.academiccloud.de/v1
# Überschreibt die Auto-Aktivierung durch API_KEY (auch mit "0" zum Abschalten).
# CODEMENTOR_LLM_ENABLED=1

# RAG
# CODEMENTOR_RAG_ENABLED=1
# CODEMENTOR_EMBED_MODEL=multilingual-e5-large-instruct
# CODEMENTOR_RAG_PATH=.codementor/rag
# CODEMENTOR_RAG_TOP_K=4
# CODEMENTOR_RAG_MAX_DISTANCE=0.32
# CODEMENTOR_RAG_MAX_PAGES=15
# Kommaseparierte Liste zusätzlicher Doku-Quellen.
# CODEMENTOR_DOC_URLS=

# Datenbank
# CODEMENTOR_DB_PATH=codementor.db

# GitHub / CI
# CODEMENTOR_ARTIFACT_NAME=codementor-analysis
# CODEMENTOR_WORKFLOW_NAME=CI
# GITHUB_API_BASE_URL=https://api.github.com
# COPILOT_AUTHOR_ALLOWLIST=copilot,github-copilot[bot]
